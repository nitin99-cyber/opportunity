# Google Gemini API Key
# Optional: used for generative AI extraction from notices and PDF resumes.
# If omitted, Opportunity Radar automatically uses its built-in offline NLP engine.
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Port to listen on (default is 3000)
PORT=3000
